{
  "schemaVersion": 1,
  "controls": [
    {
      "id": "CTRL-GOV-001",
      "title": "Standards and obligations lifecycle",
      "ownerRole": "compliance-owner",
      "frameworks": ["ISO/IEC 27001:2022", "ISO/IEC 27701:2025", "ISO 37301:2021", "ISO 9001:2015+Amd1:2024"],
      "evidence": ["standards-registry-snapshot", "applicability-decision", "edition-gap-assessment"]
    },
    {
      "id": "CTRL-AUD-001",
      "title": "Tamper-evident security and compliance audit trail",
      "ownerRole": "security-owner",
      "frameworks": ["ISO/IEC 27001:2022", "ISO/IEC 27701:2025", "ISO 15489-1:2016", "ISO 27789:2021"],
      "evidence": ["audit-schema-version", "audit-integrity-test", "retention-policy-version", "audit-access-review"]
    },
    {
      "id": "CTRL-IAM-001",
      "title": "Identity lifecycle and least-privilege authorization",
      "ownerRole": "security-owner",
      "frameworks": ["ISO/IEC 27001:2022", "ISO/IEC 27701:2025", "ISO 27799:2025"],
      "evidence": ["role-policy-version", "privileged-access-review", "identity-lifecycle-event"]
    },
    {
      "id": "CTRL-CHG-001",
      "title": "Traceable software and configuration change",
      "ownerRole": "engineering-owner",
      "frameworks": ["ISO/IEC 27001:2022", "ISO 9001:2015+Amd1:2024", "ISO/IEC 20000-1:2018", "ISO/IEC 25010:2023"],
      "evidence": ["issue-reference", "review-reference", "test-result", "build-digest", "sbom", "deployment-record"]
    },
    {
      "id": "CTRL-RSK-001",
      "title": "Recorded risk assessment, treatment and acceptance",
      "ownerRole": "risk-owner",
      "frameworks": ["ISO/IEC 27001:2022", "ISO/IEC 27005:2022", "ISO 37301:2021", "ISO 22301:2019"],
      "evidence": ["risk-record-version", "treatment-decision", "acceptance-decision", "review-history"]
    },
    {
      "id": "CTRL-PRV-001",
      "title": "Privacy purpose, retention and data-subject accountability",
      "ownerRole": "privacy-owner",
      "frameworks": ["ISO/IEC 27701:2025", "ISO/IEC 29100:2024", "ISO/IEC 27018:2025"],
      "evidence": ["processing-purpose-version", "retention-rule-version", "consent-or-authorization-evidence", "deletion-or-export-record"]
    },
    {
      "id": "CTRL-BCM-001",
      "title": "Recoverability and continuity verification",
      "ownerRole": "service-owner",
      "frameworks": ["ISO 22301:2019", "ISO/IEC 20000-1:2018", "ISO/IEC 27001:2022"],
      "evidence": ["rto-rpo-version", "backup-result", "restore-test-result", "continuity-exercise-result"]
    },
    {
      "id": "CTRL-SUP-001",
      "title": "Supplier and subprocessor assurance",
      "ownerRole": "supplier-risk-owner",
      "frameworks": ["ISO/IEC 27001:2022", "ISO/IEC 27701:2025", "ISO 37301:2021"],
      "evidence": ["supplier-assessment", "contract-or-dpa-reference", "attestation-expiry", "exit-plan"]
    },
    {
      "id": "CTRL-INC-001",
      "title": "Incident, corrective action and effectiveness verification",
      "ownerRole": "incident-owner",
      "frameworks": ["ISO/IEC 27001:2022", "ISO/IEC 27035-1:2023", "ISO 9001:2015+Amd1:2024", "ISO 37301:2021"],
      "evidence": ["incident-timeline", "root-cause-record", "corrective-action", "effectiveness-verification"]
    },
    {
      "id": "CTRL-QMS-001",
      "title": "Requirements-to-quality-evidence traceability",
      "ownerRole": "quality-owner",
      "frameworks": ["ISO 9001:2015+Amd1:2024", "ISO/IEC 25010:2023"],
      "evidence": ["requirement-reference", "acceptance-criteria", "test-result", "defect-or-exception-record"]
    }
  ]
}
